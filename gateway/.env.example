PORT=8080
CBM_BINARY=/path/to/codebase-memory-mcp
CBM_CACHE_DIR=/var/lib/graphify/cbm      # OpenShift: PVC üzerinde olmalı
CBM_ALLOWED_ROOT=/var/lib/graphify/repos # indekslemeyi tek köke hapseder
CBM_WORKERS=4                            # cgroup limitleri yanlış okunduğu için elle
CBM_MEM_BUDGET_MB=2048
# <token>:<subject>:<projeler>:<yetkiler>
GATEWAY_TOKENS=dev-token-1:isa.kulaksiz:my-project:read
