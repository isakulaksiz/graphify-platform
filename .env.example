# docker compose bu dosyayı otomatik okur:  cp .env.example .env

# ── Azure DevOps ────────────────────────────────────────────────────────────
# Bulut:    https://dev.azure.com          + AZDO_ORG=organizasyon-adi
# On-prem:  https://devops.kurum.com.tr    + AZDO_ORG=DefaultCollection
AZDO_BASE_URL=https://dev.azure.com
AZDO_ORG=
AZDO_PAT=
# Eski sunucular 7.1'i desteklemeyebilir (2019 için 5.1, 2020 için 6.0).
AZDO_API_VERSION=7.1
# Sunucu kendi CA'sı ile imzalıysa: certs/ altına koyup yolu buraya yazın.
NODE_EXTRA_CA_CERTS=

# ── Gateway ─────────────────────────────────────────────────────────────────
# none: token istenmez (lokal). bearer: token zorunlu (kurum içi yayın).
GATEWAY_AUTH=none
# bearer modunda:  <token>:<kullanici>:<proje1,proje2>:<yetki>
GATEWAY_TOKENS=

# Kullanıcının tarayıcısından erişilebilen adresler — arayüz bu adresleri
# istemci yapılandırmalarında gösterir. Sunucuya kurarken makine adını yazın.
GATEWAY_PUBLIC_URL=http://localhost:8099
CBM_UI_PUBLIC_URL=http://localhost:9749

# ── Otomatik güncelleme ─────────────────────────────────────────────────────
WEBHOOK_SECRET=degistirin
WATCH_POLL_MS=15000
WATCH_DEBOUNCE_MS=60000

# ── Kaynak ──────────────────────────────────────────────────────────────────
# Container'da cgroup limitleri yanlış okunuyor; elle verin.
CBM_WORKERS=4
CBM_MEM_BUDGET_MB=2048
