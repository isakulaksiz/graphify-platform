PORT=8090
CBM_BINARY=/path/to/codebase-memory-mcp
GATEWAY_BASE_URL=http://localhost:8099

# Azure DevOps — arayüzden de girilebilir, o zaman bunlara gerek yok.
AZDO_ORG=organizasyon-adi
AZDO_PAT=

# Yerel repolar (virgülle ayrılmış mutlak yollar)
LOCAL_REPO_ROOTS=

# Klonların tutulacağı kök dizin
CLONE_ROOT=

# Otomatik güncelleme
WATCH_POLL_MS=15000
WATCH_DEBOUNCE_MS=5000
WEBHOOK_SECRET=degistirin
